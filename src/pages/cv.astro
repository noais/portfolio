---
import Layout from '../layouts/Layout.astro';
import { profile, experience, education, community, languages, personSchema } from '../data/profile';

const summary = `${profile.role} with ${profile.yearsExperience} years in software and over a decade in native iOS. I own mobile architecture end to end, from Swift 6 concurrency and real-time video to release strategy across multiple teams, and I lead its delivery. My work spans automotive (Volkswagen Group), live video (FRiNGE), secure messaging (YEO Messaging), health (Prozis) and smart home (Bosch).`;

const skills = [
  { label: 'iOS', items: 'Swift 6, Swift Concurrency, SwiftUI, UIKit, Objective-C, App Intents, WidgetKit, watchOS, HomeKit, CoreML, ARKit, Vision' },
  { label: 'Architecture', items: 'Clean Architecture, MVVM, MVVM-C, TCA, modular codebases, internal SDKs, offline-first and on-device data' },
  { label: 'Real-time & backend', items: 'Agora RTC, WebSockets, MQTT, GraphQL, REST, BLE protocol design, Supabase, Postgres, Stripe Connect, Java/Spring' },
  { label: 'Delivery & quality', items: 'TDD, XCTest, snapshot testing, Bitrise, GitHub Actions, Fastlane, Jenkins, release management, SAFe PI planning' },
  { label: 'Also', items: 'Kotlin, Jetpack Compose, Python, Bash, RAG and LLM integration, Claude Code, Codex' },
];

const products = [
  { name: 'Velko', status: 'Launching in Portugal · iOS & Android', body: 'Peer-to-peer rental marketplace for water-sports gear: map search, Stripe Connect payments with held deposits, photo-evidenced handovers and real-time chat.', href: '/velko/' },
  { name: 'Nursling', status: 'On the App Store · iPhone & Apple Watch', body: 'One-tap breastfeeding tracker. A single App Intent drives the widget, Control Centre, Action Button, Siri, Live Activity and Watch app. No account, no server; 21 languages.', href: '/nursling/' },
  { name: 'RidersNow', status: 'On the App Store · Android coming soon', body: 'Live map of kite, surf, wing and windsurf sessions at nearby spots, with session chat and an hourly conditions forecast.', href: '/ridersnow-site/' },
  { name: 'MyLedgerAI', status: 'iOS', body: 'Privacy-first, chat-led finance companion using on-device storage, RAG over the user’s own data and Vision OCR for receipts.' },
];

const pageTitle = `${profile.name} — CV · ${profile.role}`;
const pageDescription = `CV of ${profile.name}, ${profile.role}. ${profile.yearsExperience} years in software; FRiNGE, Volkswagen Group, YEO Messaging, Prozis, Bosch. ${profile.availability}`;

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfilePage',
      '@id': `${profile.site}/cv/#profilepage`,
      url: `${profile.site}/cv/`,
      name: pageTitle,
      mainEntity: { '@id': personSchema['@id'] },
    },
    { ...personSchema, description: summary },
  ],
};
---

<Layout title={pageTitle} description={pageDescription} structuredData={structuredData}>

<a href="#main" class="skip-link">Skip to content</a>

<header class="nav-shell">
  <nav class="nav-inner" aria-label="Primary">
    <a href="/" class="nav-logo" aria-label="David Ferreira, portfolio home">DF</a>
    <ul class="nav-links">
      <li><a href="/">Portfolio</a></li>
      <li class="nav-optional"><a href="/ai-consulting/">AI Consulting</a></li>
      <li><button type="button" class="nav-print" data-print>Save as PDF</button></li>
      <li><a href={`mailto:${profile.email}`} class="nav-cta">Email me</a></li>
    </ul>
  </nav>
</header>

<main id="main" class="cv">
  <header class="cv-head">
    <p class="cv-eyebrow">Curriculum vitae</p>
    <h1 class="cv-name">{profile.name}</h1>
    <p class="cv-role">{profile.role}</p>
    <ul class="cv-contact">
      <li><a href={`mailto:${profile.email}`}>{profile.email}</a></li>
      <li><a href={profile.linkedin}>linkedin.com/in/david-ferreira-69041367</a></li>
      <li><a href={profile.github}>github.com/noais</a></li>
      <li><a href={profile.site}>davidferreira.dev</a></li>
    </ul>
    <p class="cv-availability"><span class="status-dot" aria-hidden="true"></span>{profile.availability} {profile.timezone}.</p>
  </header>

  <section class="cv-section" aria-labelledby="cv-summary">
    <h2 id="cv-summary" class="cv-h2">Summary</h2>
    <p class="cv-summary">{summary}</p>
  </section>

  <section class="cv-section" aria-labelledby="cv-experience">
    <h2 id="cv-experience" class="cv-h2">Experience</h2>
    <ol class="cv-roles">
      {experience.map((r) => (
        <li class="cv-role-item">
          <div class="cv-role-head">
            <h3 class="cv-role-title">{r.role} <span class="cv-at">· {r.company}</span></h3>
            <p class="cv-period">
              <time datetime={r.start}>{r.period.split(' – ')[0]}</time> – <time datetime={r.end}>{r.period.split(' – ')[1]}</time>
            </p>
          </div>
          <ul class="cv-points">
            {r.highlights.map((h) => <li>{h}</li>)}
          </ul>
          <p class="cv-stack">{r.stack.join(' · ')}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="cv-section" aria-labelledby="cv-products">
    <h2 id="cv-products" class="cv-h2">Independent products</h2>
    <ul class="cv-products">
      {products.map((p) => (
        <li>
          <h3 class="cv-role-title">
            {p.href ? <a href={p.href}>{p.name}</a> : p.name}
            <span class="cv-at">· {p.status}</span>
          </h3>
          <p class="cv-product-body">{p.body}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="cv-section" aria-labelledby="cv-skills">
    <h2 id="cv-skills" class="cv-h2">Skills</h2>
    <dl class="cv-skills">
      {skills.map((s) => (
        <div>
          <dt>{s.label}</dt>
          <dd>{s.items}</dd>
        </div>
      ))}
    </dl>
  </section>

  <div class="cv-cols">
    <section class="cv-section" aria-labelledby="cv-education">
      <h2 id="cv-education" class="cv-h2">Education</h2>
      <p class="cv-strong">{education.degree}</p>
      <p class="cv-muted">{education.school}</p>
      <p class="cv-muted cv-small">{education.note}</p>
    </section>
    <section class="cv-section" aria-labelledby="cv-community">
      <h2 id="cv-community" class="cv-h2">Community</h2>
      <ul class="cv-list">
        {community.map((c) => <li><span class="cv-strong">{c.name}</span> <span class="cv-muted">{c.detail}</span></li>)}
      </ul>
    </section>
    <section class="cv-section" aria-labelledby="cv-languages">
      <h2 id="cv-languages" class="cv-h2">Languages</h2>
      <ul class="cv-list">
        {languages.map((l) => <li><span class="cv-strong">{l.name}</span> <span class="cv-muted">{l.level}</span></li>)}
      </ul>
    </section>
  </div>
</main>

<footer class="footer">
  <p><a href="/">Portfolio</a> · <a href="/ai-consulting/">AI Consulting</a> · <a href={`mailto:${profile.email}`}>{profile.email}</a></p>
</footer>

</Layout>

<script>
  document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
</script>

<style>
/* ── Nav (same shell as the landing pages) ────────────────────── */
.nav-shell {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 100;
  background: rgba(13,15,26,0.85);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border-bottom: 1px solid rgba(237,233,226,0.07);
}
.nav-inner {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 2rem;
  height: 60px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.nav-logo {
  font-family: 'Fraunces', Georgia, serif;
  font-size: 1.25rem;
  font-weight: 600;
  color: var(--ink);
  text-decoration: none;
  letter-spacing: -0.02em;
}
.nav-links {
  display: flex;
  align-items: center;
  gap: 2rem;
  list-style: none;
  margin: 0; padding: 0;
}
.nav-links a,
.nav-print {
  font: inherit;
  font-size: 0.875rem;
  font-weight: 500;
  color: var(--muted);
  text-decoration: none;
  white-space: nowrap;
  background: none;
  border: 0;
  padding: 0;
  cursor: pointer;
  transition: color 0.15s;
}
.nav-links a:hover,
.nav-print:hover { color: var(--ink); }
.nav-links .nav-cta {
  background: var(--lime);
  color: #0D0F1A !important;
  padding: 0.5rem 1.125rem !important;
  border-radius: 100px;
}
.nav-links .nav-cta:hover { background: #d4ff3a; }

/* ── CV ───────────────────────────────────────────────────────── */
.cv {
  max-width: 820px;
  margin: 0 auto;
  padding: 132px 2rem 96px;
}
.cv-head {
  padding-bottom: 2.5rem;
  border-bottom: 1px solid rgba(237,233,226,0.08);
}
.cv-eyebrow {
  font-size: 0.7rem;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--lime);
  margin: 0 0 0.75rem;
}
.cv-name {
  font-family: 'Fraunces', Georgia, serif;
  font-size: clamp(2.5rem, 6vw, 3.75rem);
  letter-spacing: -0.035em;
  margin: 0 0 0.5rem;
}
.cv-role {
  font-family: 'Fraunces', Georgia, serif;
  font-style: italic;
  font-weight: 300;
  font-size: clamp(1.25rem, 3vw, 1.625rem);
  color: var(--lime);
  margin: 0 0 1.5rem;
}
.cv-contact {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem 1.5rem;
  list-style: none;
  margin: 0 0 1.25rem; padding: 0;
  font-size: 0.875rem;
}
.cv-contact a,
.cv-products a {
  color: var(--ink);
  text-decoration: underline;
  text-decoration-color: rgba(237,233,226,0.25);
  text-underline-offset: 3px;
}
.cv-contact a:hover,
.cv-products a:hover { color: var(--lime); }
.cv-availability {
  display: flex;
  align-items: baseline;
  gap: 0.6rem;
  font-size: 0.875rem;
  color: rgba(237,233,226,0.75);
  margin: 0;
}
.status-dot {
  align-self: flex-start;
  margin-top: 0.55em;
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--lime);
  flex-shrink: 0;
}
.cv-section { padding-top: 2.5rem; }
.cv-h2 {
  font-family: inherit;
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--lime);
  margin: 0 0 1.25rem;
}
.cv-summary {
  font-size: 1.0625rem;
  line-height: 1.7;
  color: rgba(237,233,226,0.82);
  margin: 0;
}
.cv-roles,
.cv-products {
  list-style: none;
  margin: 0; padding: 0;
  display: grid;
  gap: 2rem;
}
.cv-role-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 0.25rem 1rem;
  flex-wrap: wrap;
  margin-bottom: 0.6rem;
}
.cv-role-title {
  font-family: inherit;
  font-size: 1rem;
  font-weight: 600;
  line-height: 1.4;
  color: var(--ink);
  margin: 0;
}
.cv-at { font-weight: 400; color: rgba(237,233,226,0.62); }
.cv-period {
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.75rem;
  color: rgba(237,233,226,0.62);
  margin: 0;
  white-space: nowrap;
}
.cv-points {
  margin: 0; padding: 0 0 0 1.1rem;
  display: grid;
  gap: 0.4rem;
}
.cv-points li {
  font-size: 0.9375rem;
  line-height: 1.55;
  color: rgba(237,233,226,0.75);
}
.cv-points li::marker { color: var(--lime); }
.cv-stack {
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.7rem;
  color: rgba(237,233,226,0.62);
  margin: 0.75rem 0 0;
}
.cv-product-body {
  font-size: 0.9375rem;
  line-height: 1.55;
  color: rgba(237,233,226,0.75);
  margin: 0.35rem 0 0;
}
.cv-skills { margin: 0; display: grid; gap: 0.75rem; }
.cv-skills div {
  display: grid;
  grid-template-columns: 170px 1fr;
  gap: 1rem;
}
.cv-skills dt { font-size: 0.875rem; font-weight: 600; color: var(--ink); }
.cv-skills dd { margin: 0; font-size: 0.875rem; line-height: 1.6; color: rgba(237,233,226,0.75); }
.cv-cols {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 2rem;
}
.cv-strong { font-size: 0.9375rem; font-weight: 600; color: var(--ink); margin: 0; }
.cv-muted { font-size: 0.875rem; color: rgba(237,233,226,0.62); margin: 0.2rem 0 0; }
.cv-small { font-size: 0.8125rem; line-height: 1.5; margin-top: 0.5rem; }
.cv-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.5rem; }
.cv-list li { line-height: 1.45; }
.cv-list .cv-muted { display: block; margin: 0; }

.footer {
  background: var(--navy);
  border-top: 1px solid rgba(237,233,226,0.05);
  padding: 2rem;
  text-align: center;
  font-size: 0.8125rem;
  color: rgba(237,233,226,0.62);
}
.footer p { margin: 0; }
.footer a { color: inherit; text-underline-offset: 3px; }
.footer a:hover { color: var(--lime); }

@media (max-width: 700px) {
  .nav-inner { padding: 0 1.25rem; }
  .nav-links { gap: 1rem; }
  .nav-links a, .nav-print { font-size: 0.8125rem; }
  .nav-links .nav-cta { padding: 0.45rem 0.875rem !important; }
  .nav-optional { display: none; }
  .cv { padding: 104px 1.25rem 72px; }
  .cv-skills div { grid-template-columns: 1fr; gap: 0.15rem; }
  .cv-cols { grid-template-columns: 1fr; gap: 0; }
}

/* ── Print: a plain, ink-friendly one-column CV ───────────────── */
@media print {
  @page { margin: 14mm 16mm; }
  :global(html),
  :global(body) { background: #fff !important; color: #111 !important; }
  .nav-shell, .footer, .skip-link { display: none !important; }
  .cv { max-width: none; padding: 0; }
  .cv-head { padding-bottom: 1rem; border-color: #ccc; }
  .cv-name { font-size: 26pt; color: #111; }
  .cv-role, .cv-eyebrow, .cv-h2 { color: #3d5200; }
  .cv-section { padding-top: 1.1rem; }
  .cv-h2 { margin-bottom: 0.5rem; }
  .cv-roles { gap: 0.9rem; }
  .cv-products { gap: 0.6rem; }
  .cv-role-item, .cv-products li, .cv-skills div { break-inside: avoid; }
  .cv-role-title, .cv-strong, .cv-skills dt, .cv-contact a, .cv-products a { color: #111; }
  .cv-at, .cv-period, .cv-stack, .cv-muted, .cv-availability { color: #555; }
  .cv-summary, .cv-points li, .cv-product-body, .cv-skills dd { color: #222; font-size: 10pt; }
  .cv-points li::marker { color: #3d5200; }
  .status-dot { display: none; }
  .cv-cols { grid-template-columns: repeat(3, 1fr); gap: 1rem; }
}
</style>
