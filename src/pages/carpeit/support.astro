---
import CarpeItDoc from '../../layouts/CarpeItDoc.astro';
import { ownerPricingSummary, foundingMigrationSummary, foundingApplicationsSummary, existingBookingSummary } from '../../data/carpeitPricing';
import { carpeitOperator, complaintsBookUrl } from '../../data/carpeitOperator';

const supportMail = `mailto:${carpeitOperator.email}?subject=${encodeURIComponent('CarpeIt support')}`;

const faqs: { q: string; a: string; link?: { href: string; label: string } }[] = [
  {
    q: 'How does booking work?',
    a: 'Pick your dates and send a request. Your card is authorised for the rental price but not charged. The owner has 72 hours to accept. If they accept, you are charged and the exact pickup point unlocks in your rental. If they decline or don’t answer, the authorisation is released and you pay nothing.',
  },
  {
    q: 'Are there any fees for renters?',
    a: 'No. You pay the rental price shown before you book. Owners pay CarpeIt a service fee out of the rental price, so nothing is added for you.',
  },
  {
    q: 'What commission do owners pay?',
    a: `${ownerPricingSummary} ${existingBookingSummary}`,
    link: { href: '/carpeit/terms/#owner-fees', label: 'Owner fees and eligibility' },
  },
  {
    q: 'Who qualifies as a Founding Partner?',
    a: `${foundingMigrationSummary} ${foundingApplicationsSummary}`,
    link: { href: supportMail, label: 'Contact us about eligibility' },
  },
  {
    q: 'How does the deposit work?',
    a: 'If a listing has a deposit, a hold for that amount is placed on your card from about 24 hours before pickup. It is not a charge. It is released when the owner confirms the gear came back as expected, or automatically 24 hours after the return if the owner doesn’t make a claim. For rentals longer than about 5 days, the hold is renewed before it expires, so you may briefly see a new hold replace the old one. If the hold can’t be placed, update your card before pickup.',
  },
  {
    q: 'Can I cancel?',
    a: 'A request can be cancelled at any time for free. After the owner accepts, cancelling is free until 48 hours before pickup and you get a full refund; after that, the rental price isn’t refunded. The app shows the exact refund before you confirm. If an owner cancels, you are always refunded in full.',
  },
  {
    q: 'Why do I have to take photos at pickup and return?',
    a: 'They are the shared record of the gear’s condition, and they protect both of you. Both of you can see them. A handover can’t be confirmed until the photos have finished uploading, so keep the app open for a moment on a weak connection.',
  },
  {
    q: 'The gear came back damaged. What happens?',
    a: 'As the owner, open a claim from the rental before you confirm the return: describe what happened and how much of the deposit you’re asking for. The renter has 48 hours to accept or dispute it. If they accept, that amount goes to you and the rest of the hold is released. If they dispute it or don’t answer, the deposit stays on hold while CarpeIt reviews the handover photos and your messages, then decides how much goes to the owner and releases the rest. Both of you are told the outcome and the reasons in the rental’s conversation, and either of you can ask for a review within 14 days.',
  },
  {
    q: 'How do I get paid for lending gear?',
    a: 'Go to Profile → Payments & payouts and set up payouts with Stripe. You need this before you can accept a booking. CarpeIt’s fee and the amount you’ll receive are shown before you publish a listing and on every booking.',
  },
  {
    q: 'Someone is being abusive. What can I do?',
    a: 'In the conversation, tap the menu at the top and choose Report or Block. Once you block someone, neither of you can message or book the other, and they are not told. You can also report a listing from its page, or a user from a completed rental. Reports are reviewed by a person, usually within 2 working days. If someone is in immediate danger, call 112 first.',
  },
  {
    q: 'How do I delete my account?',
    a: 'Go to Profile and tap Delete account. If you have a rental in progress, finish or cancel it first. If you can’t use the app, email us from the address on your account with the subject “Delete my CarpeIt account”, and we’ll delete it within 30 days. Your login and personal details are removed; records of past rentals stay for the other person, shown as “Deleted user”, for as long as the law requires. The Delete account page explains exactly what is kept and for how long.',
    link: { href: '/carpeit/delete-account/', label: 'How to delete your account' },
  },
  {
    q: 'Can I get a copy of my data?',
    a: 'Yes. Email us from the address on your account with the subject “CarpeIt data export”. We’ll send you a copy of your account, listings, bookings, messages and other data in a machine-readable format within a month, as the GDPR requires. You can also ask us to correct or delete anything.',
    link: { href: '/carpeit/privacy/', label: 'Read the Privacy Policy' },
  },
];
---

<CarpeItDoc
  title="CarpeIt — Support"
  description="Help with renting and lending water sports gear on CarpeIt, and how to contact support."
  heading="Support"
>
  <p class="doc-lead">
    Stuck on a booking, a payment or a handover? Most answers are below. If yours isn't, email <a href={supportMail}>{carpeitOperator.email}</a> and
    include the listing or rental it's about. We usually reply within 2 working days.
  </p>

  <div class="faq">
    {faqs.map((f) => (
      <details>
        <summary>{f.q}</summary>
        <p>{f.a}</p>
        {f.link && <p><a href={f.link.href}>{f.link.label}</a></p>}
      </details>
    ))}
  </div>

  <h2>Contact</h2>
  <p>
    Email <a href={supportMail}>{carpeitOperator.email}</a>. We usually reply within 2 working days.
    For anything about your data, see the <a href="/carpeit/privacy/">Privacy Policy</a>; to close
    your account, <a href="/carpeit/delete-account/">Delete your account</a>; for the rules of
    renting and lending, the <a href="/carpeit/terms/">Terms of Service</a>.
  </p>
  <p>
    Not happy with how we handled something? You can also use the
    <a href={complaintsBookUrl}>electronic complaints book (Livro de Reclamações)</a>, or, as a
    consumer, take a dispute to <a href="https://www.cniacc.pt">CNIACC</a>, a consumer
    arbitration centre. CarpeIt is operated by {carpeitOperator.name}, {carpeitOperator.address}.
  </p>

  <p class="doc-note">
    If someone is in danger on the water or on land, call 112 (the EU emergency number) or your
    local emergency services first.
  </p>
</CarpeItDoc>
