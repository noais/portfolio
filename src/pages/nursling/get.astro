---
// /nursling/get/: the one link to promote (and the target of the QR code at
// /nursling/nursling-qr.svg). Phones go straight to their own store; anything else
// sees both store buttons and the QR to scan with a phone.
const appStoreUrl = 'https://apps.apple.com/app/nursling-breastfeeding-tracker/id6809155622';
const playStoreUrl = 'https://play.google.com/store/apps/details?id=com.davidferreira.nursling';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Get Nursling</title>
  <meta name="description" content="Download Nursling, the one-tap breastfeeding tracker, for iPhone or Android." />
  <meta name="robots" content="noindex" />
  <link rel="canonical" href="https://davidferreira.dev/nursling/" />
  <link rel="icon" href="/nursling/app-icon.png" />
  <script is:inline define:vars={{ appStoreUrl, playStoreUrl }}>
    // Runs before the body renders, so a phone never sees this page at all.
    var ua = navigator.userAgent;
    var isIOS = /iPhone|iPad|iPod/.test(ua) || (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1);
    if (/Android/i.test(ua)) location.replace(playStoreUrl);
    else if (isIOS) location.replace(appStoreUrl);
  </script>
  <style>
    :root {
      --bg: #ffffff;
      --text: #1f1830;
      --muted: #6b6480;
      --accent: #8b5cf6;
      --card: #f6f2ff;
    }
    @media (prefers-color-scheme: dark) {
      :root:not([data-theme="light"]) {
        --bg: #07090f;
        --text: #f3f0fa;
        --muted: #a49cb8;
        --card: #161427;
      }
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      min-height: 100vh;
      display: grid;
      place-items: center;
      padding: 2rem 1rem;
      background: var(--bg);
      color: var(--text);
      font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
      text-align: center;
    }
    main { max-width: 26rem; }
    .icon { width: 88px; height: 88px; border-radius: 22px; }
    h1 { font-size: 1.75rem; margin: 1rem 0 0.25rem; }
    p { color: var(--muted); margin: 0 0 1.5rem; line-height: 1.5; }
    .stores { display: flex; flex-direction: column; gap: 0.75rem; }
    .stores a {
      display: block;
      padding: 0.9rem 1.25rem;
      border-radius: 999px;
      background: var(--accent);
      color: #fff;
      font-weight: 600;
      text-decoration: none;
    }
    .stores a:focus-visible { outline: 3px solid var(--text); outline-offset: 3px; }
    .qr {
      margin-top: 2rem;
      padding: 1.25rem;
      border-radius: 1.25rem;
      background: var(--card);
    }
    .qr img { width: 180px; height: 180px; background: #fff; border-radius: 0.75rem; padding: 0.5rem; }
    .qr p { margin: 0.75rem 0 0; font-size: 0.9rem; }
    .more { display: inline-block; margin-top: 1.5rem; color: var(--accent); }
  </style>
</head>
<body>
  <main>
    <img src="/nursling/app-icon.png" alt="Nursling app icon" class="icon" width="88" height="88" />
    <h1>Get Nursling</h1>
    <p>One-tap breastfeeding tracker. No account, no cloud, no ads.</p>
    <div class="stores">
      <a href={appStoreUrl}>Download on the App Store</a>
      <a href={playStoreUrl}>Get it on Google Play</a>
    </div>
    <div class="qr">
      <img src="/nursling/nursling-qr.svg" alt="QR code linking to davidferreira.dev/nursling/get" width="180" height="180" />
      <p>Scan with your phone's camera.</p>
    </div>
    <a href="/nursling/" class="more">Learn more about Nursling</a>
  </main>
</body>
</html>
