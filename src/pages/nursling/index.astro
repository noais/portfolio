---
import Layout from '../../layouts/Layout.astro';

// App Store URL; set to null to fall back to the "Coming to the App Store" placeholder CTAs.
const appStoreUrl: string | null = 'https://apps.apple.com/app/nursling-breastfeeding-tracker/id6809155622';

const strip = [
  'No account',
  'No cloud',
  'No ads',
  'No tracking',
  'iPhone & Apple Watch',
  '21 languages',
];

const features = [
  {
    eyebrow: 'One tap',
    title: 'The button is already on the right side.',
    body:
      'Open Nursling and the primary button is set to the breast that comes next. Tap it and you are tracking. No confirmation screen, no dialogs, nothing to dismiss.',
    points: [
      'Starts you on the breast you finished on last time',
      'Switch sides mid-session and it still counts as one nursing',
      'A distinct haptic for every action, so you can feel the confirmation',
    ],
    image: '/nursling/02-home.png',
    alt: 'Nursling home screen showing time since the last nursing and the Nurse Left button',
  },
  {
    eyebrow: 'Built for night',
    title: 'A screen that will not wake anyone.',
    body:
      'The active nursing screen goes dark, drops to one glyph and one timer, and puts Switch and Finish where a thumb already is. Dark from 9pm to 5am, even if the phone is in light mode.',
    points: [
      'Buttons big enough to hit without looking',
      'Undo sits beside the timer, for the tap you did not mean',
      'A Live Activity shows the current side, and ends the moment you finish',
    ],
    image: '/nursling/03-active-left.png',
    alt: 'Nursling active nursing screen showing the left breast and a running timer on a dark background',
  },
  {
    eyebrow: 'Insights',
    title: 'See the pattern, not a spreadsheet.',
    body:
      'Week, month and all-time views answer the questions a parent actually asks: how many, how long, and whether the sides are staying balanced.',
    points: [
      'Time between nursings measured start to start — the number you want at a glance',
      'Average duration and total time per period',
      'Left versus right balance, so you notice a drift early',
    ],
    image: '/nursling/05-insights.png',
    alt: 'Nursling insights screen showing nursing count, total time, average duration and a left versus right chart',
  },
  {
    eyebrow: 'Private by design',
    title: 'The data never leaves the phone.',
    body:
      'Nursling has no account, no server and no analytics. Sessions live in a local store and ride along in your encrypted device backup. Export to CSV whenever you like — that stays free forever.',
    points: [
      'No sign-up, no email, no cloud sync',
      'No ads, no third-party SDKs, no tracking of any kind',
      'A CSV export you own, free whether you buy or not',
    ],
    image: '/nursling/06-settings-privacy.png',
    alt: 'Nursling settings screen showing reminders, dark at night, CSV export and privacy notes',
  },
];

const surfaces = [
  { title: 'Home Screen widget', body: 'Start a nursing straight from the widget, without opening the app.' },
  { title: 'Control Centre', body: 'Add the control and start one from a locked phone in a single swipe.' },
  { title: 'Action Button', body: 'Map it once, and the side you need is one squeeze away.' },
  { title: 'Siri & Shortcuts', body: 'Ask, and the session starts — your hands stay where they are.' },
  { title: 'Live Activity', body: 'The running side and timer on the Lock Screen and in the Dynamic Island.' },
  { title: 'Apple Watch', body: 'A companion app for the nights the phone is across the room.' },
];

const build = [
  { label: 'Platform', items: ['Swift 6', 'SwiftUI', 'iOS', 'watchOS'] },
  { label: 'System surfaces', items: ['App Intents', 'WidgetKit', 'Live Activities', 'Control Center'] },
  { label: 'Data', items: ['Local SQLite event store', 'CSV export', 'No network layer'] },
  { label: 'Delivery', items: ['StoreKit 2', '21 localizations', 'Automated storefront capture', 'asc CLI releases'] },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Nursling: Breastfeeding Tracker',
  operatingSystem: 'iOS, watchOS',
  applicationCategory: 'HealthApplication',
  description:
    'A deliberately minimal breastfeeding tracker. One tap starts a nursing — from the Home Screen, Control Centre, the Action Button or Siri. No account, no cloud, no tracking.',
  author: { '@type': 'Person', name: 'David Ferreira', url: 'https://davidferreira.dev' },
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'EUR',
    description: 'Free for the first 50 nurslings, then a single one-time purchase for unlimited tracking.',
  },
};
---

<Layout
  title="Nursling — a breastfeeding tracker built for 3am."
  description="Nursling is a deliberately minimal iOS breastfeeding tracker. One tap starts a nursing — from the Home Screen, Control Centre, the Action Button or Siri. No account, no cloud, no tracking."
  keywords="breastfeeding tracker, nursing tracker, newborn feeding log, private baby tracker, iOS app, Nursling"
  structuredData={structuredData}
>

<!-- ─── NAV ─────────────────────────────────────────────────────── -->
<header class="nav-shell">
  <nav class="nav-inner">
    <a href="/" class="nav-logo">DF</a>
    <ul class="nav-links">
      <li><a href="#features" data-nav="features">Features</a></li>
      <li><a href="#surfaces" data-nav="surfaces">Anywhere</a></li>
      <li><a href="#pricing" data-nav="pricing">Pricing</a></li>
      <li><a href="/">Portfolio</a></li>
      <li><a href="#get" class="nav-cta">Get Nursling</a></li>
    </ul>
  </nav>
</header>

<!-- ─── HERO ──────────────────────────────────────────────────────── -->
<section id="top" class="hero-section">
  <div class="hero-glow" aria-hidden="true"></div>
  <div class="hero-grid">

    <div class="hero-copy">
      <div class="hero-id">
        <img src="/nursling/app-icon.png" alt="Nursling app icon" class="hero-icon" width="72" height="72" />
        <div>
          <p class="hero-name">Nursling</p>
          <p class="hero-kicker">Breastfeeding Tracker · iPhone &amp; Apple Watch</p>
        </div>
      </div>

      <h1 class="hero-headline">
        One tap.<br />
        <em>No timers. No fuss.</em>
      </h1>

      <p class="hero-sub">
        A breastfeeding tracker built for one moment: 3am, one hand free, a baby in the other
        arm. It answers the only two questions that matter — which breast comes next, and how
        long since the last one — and records a nursing in a single tap.
      </p>

      <div class="hero-actions">
        {appStoreUrl ? (
          <a href={appStoreUrl} target="_blank" rel="noopener" class="btn-primary" data-app-store>Download on the App Store</a>
        ) : (
          <span class="btn-primary btn-primary--pending">Coming to the App Store</span>
        )}
        <a href="#features" class="btn-ghost">See how it works</a>
      </div>

      <p class="hero-note">
        Free for your first 50 nurslings. A one-time unlock after that — never a subscription.
      </p>
    </div>

    <div class="hero-visual" aria-hidden="true">
      <div class="phone-stack">
        <div class="phone phone--back">
          <img src="/nursling/03-active-left.png" alt="" loading="eager" />
        </div>
        <div class="phone phone--front">
          <img src="/nursling/02-home.png" alt="" loading="eager" />
        </div>
      </div>
    </div>

  </div>
</section>

<!-- ─── PROOF STRIP ───────────────────────────────────────────────── -->
<div class="proof-strip">
  <p class="proof-label">Private by design</p>
  <ul class="proof-domains">
    {strip.map((s) => (
      <li>{s}</li>
    ))}
  </ul>
</div>

<!-- ─── PREMISE ───────────────────────────────────────────────────── -->
<section id="premise" class="section">
  <div class="section-inner premise-grid">
    <div class="premise-copy">
      <span class="eyebrow">The premise</span>
      <h2 class="premise-headline">
        A parent at 3am should not have to navigate, confirm, or decide.
      </h2>
      <p class="premise-body">
        Most baby apps are built for the daytime version of you — the one with two free hands, a
        clear head, and patience for a form. Nursling was scoped down until only the 3am version
        was left. Everything that asked you to think got cut: no session type picker, no
        confirmation sheet, no "which side?" question, because the app already knows.
      </p>
      <div class="premise-stats">
        <div class="premise-stat">
          <span class="premise-num">1</span>
          <span class="premise-cap">tap to start a nursing</span>
        </div>
        <div class="premise-stat">
          <span class="premise-num">0</span>
          <span class="premise-cap">accounts, servers or trackers</span>
        </div>
        <div class="premise-stat">
          <span class="premise-num">6</span>
          <span class="premise-cap">places you can start one from</span>
        </div>
      </div>
    </div>

    <div class="premise-visual">
      <div class="premise-phone">
        <img
          src="/nursling/01-onboarding.png"
          alt="Nursling welcome screen reading &quot;A simpler way to keep close. Track breastfeeding with one tap.&quot; and &quot;No account. No cloud. Just your journey.&quot;"
          loading="lazy"
          width="248"
          height="512"
        />
      </div>
    </div>
  </div>
</section>

<!-- ─── FEATURES ──────────────────────────────────────────────────── -->
<section id="features" class="section section--navy">
  <div class="section-inner">
    <div class="section-header">
      <span class="eyebrow eyebrow--accent">What it does</span>
      <h2 class="section-title">Narrow on purpose.</h2>
    </div>

    <div class="feature-list">
      {features.map((f) => (
        <article class="feature-row reveal">
          <div class="feature-shot">
            <div class="feature-phone">
              <img src={f.image} alt={f.alt} loading="lazy" width="232" height="400" />
            </div>
          </div>
          <div class="feature-body">
            <span class="feature-eyebrow">{f.eyebrow}</span>
            <h3 class="feature-title">{f.title}</h3>
            <p class="feature-text">{f.body}</p>
            <ul class="feature-points">
              {f.points.map((p) => (
                <li>{p}</li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- ─── SURFACES ──────────────────────────────────────────────────── -->
<section id="surfaces" class="section section--navy">
  <div class="section-inner">
    <div class="section-header">
      <span class="eyebrow eyebrow--accent">Anywhere</span>
      <h2 class="section-title">Track without opening the app.</h2>
      <p class="section-lede">
        The fastest interaction is the one that never reaches the app. Nursling ships the same
        intent to every surface iOS gives it, so a session starts wherever your hand already is.
      </p>
    </div>

    <div class="surface-grid">
      {surfaces.map((s) => (
        <div class="surface-panel">
          <h3 class="surface-title">{s.title}</h3>
          <p class="surface-body">{s.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ─── PRICING ───────────────────────────────────────────────────── -->
<section id="pricing" class="section">
  <div class="section-inner">
    <div class="section-header">
      <span class="eyebrow">Pricing</span>
      <h2 class="section-title">One purchase. No subscription.</h2>
    </div>

    <div class="price-grid">
      <div class="price-card">
        <p class="price-tier">Free</p>
        <p class="price-amount">Your first 50 nurslings</p>
        <ul class="price-points">
          <li>Every feature, unmodified</li>
          <li>Widget, Control Centre, Siri and Live Activity</li>
          <li>Insights and full history</li>
          <li>CSV export</li>
        </ul>
      </div>
      <div class="price-card price-card--accent">
        <p class="price-tier">Unlimited</p>
        <p class="price-amount">A one-time purchase</p>
        <ul class="price-points">
          <li>Unlimited nurslings, forever</li>
          <li>No subscription, no renewal</li>
          <li>Your history stays readable whether you buy or not</li>
          <li>CSV export stays free either way</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- ─── BUILD ─────────────────────────────────────────────────────── -->
<section id="build" class="section section--navy">
  <div class="section-inner">
    <div class="section-header">
      <span class="eyebrow eyebrow--accent">Behind the build</span>
      <h2 class="section-title">Designed, built and shipped solo.</h2>
      <p class="section-lede">
        Nursling is a personal product by <a href="/">David Ferreira</a> — the domain logic, the
        SwiftUI app, the widget extension, the watch app, the storefront pipeline and the release
        automation.
      </p>
    </div>

    <div class="build-grid">
      {build.map((b) => (
        <div class="build-panel">
          <h3 class="build-title">{b.label}</h3>
          <ul class="build-items">
            {b.items.map((i) => (
              <li>{i}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ─── GET ───────────────────────────────────────────────────────── -->
<section id="get" class="section section--navy">
  <div class="section-inner get-inner">
    <span class="eyebrow eyebrow--accent">Get Nursling</span>
    <h2 class="get-headline">Built for the nights you will not remember.</h2>
    <p class="get-sub">
      {appStoreUrl
        ? 'Available on the App Store for iPhone and Apple Watch, in 21 languages.'
        : 'Nursling is on its way to the App Store. It ships for iPhone and Apple Watch, in 21 languages.'}
    </p>
    <div class="hero-actions">
      {appStoreUrl ? (
        <a href={appStoreUrl} target="_blank" rel="noopener" class="btn-primary" data-app-store>Download on the App Store</a>
      ) : (
        <span class="btn-primary btn-primary--pending">Coming to the App Store</span>
      )}
      <a href="mailto:hey@davidferreira.dev?subject=Nursling" class="btn-ghost">Ask a question</a>
    </div>
    <p class="disclaimer">
      Nursling is a log, not medical advice. For questions about feeding, weight gain or supply,
      talk to your pediatrician.
    </p>
  </div>
</section>

<!-- ─── FOOTER ────────────────────────────────────────────────────── -->
<footer class="footer">
  <p class="footer-links">
    <a href="/nursling/privacy/">Privacy</a>
    <span aria-hidden="true">·</span>
    <a href="/nursling/support/">Support</a>
    <span aria-hidden="true">·</span>
    <a href="/">Portfolio</a>
  </p>
  <p>David Ferreira · Portugal · <span id="year"></span></p>
  <script>document.getElementById('year').textContent = new Date().getFullYear().toString();</script>
</footer>

<script>
  // On the web, an App Store link without a country always lands on the US store, so send
  // visitors to the store and language of their browser locale. iOS opens the App Store app,
  // which already uses the visitor's own store, so links there stay as they are.
  const isIOS = /iPhone|iPad|iPod/.test(navigator.userAgent)
    || (/Macintosh/.test(navigator.userAgent) && navigator.maxTouchPoints > 1);
  if (!isIOS) {
    try {
      // maximize() fills in the likely region for bare languages, e.g. "de" → "de-DE".
      const locale = new Intl.Locale(navigator.languages?.[0] ?? navigator.language).maximize();
      if (locale.region && /^[A-Z]{2}$/.test(locale.region)) {
        document.querySelectorAll<HTMLAnchorElement>('a[data-app-store]').forEach((link) => {
          const url = new URL(link.href);
          url.pathname = `/${locale.region!.toLowerCase()}${url.pathname}`;
          url.searchParams.set('l', locale.language);
          link.href = url.toString();
        });
      }
    } catch {
      // Unparseable locale: keep the country-less link.
    }
  }
</script>

</Layout>

<style>
/* Nursling's own violet + pink accents, on the site's dark navy shell */
:root {
  --accent:   #7C5CFF;
  --accent-2: #FF5CA8;
  --accent-soft: #A08CFF;
}

/* ── Nav ───────────────────────────────────────────────────────── */
.nav-shell {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 100;
  background: rgba(13,15,26,0.85);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border-bottom: 1px solid rgba(237,233,226,0.07);
}
.nav-inner {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 2rem;
  height: 60px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.nav-logo {
  font-family: 'Fraunces', Georgia, serif;
  font-size: 1.25rem;
  font-weight: 600;
  color: var(--ink);
  text-decoration: none;
  letter-spacing: -0.02em;
}
.nav-links {
  display: flex;
  align-items: center;
  gap: 2rem;
  list-style: none;
  margin: 0; padding: 0;
}
.nav-links a {
  font-size: 0.875rem;
  font-weight: 500;
  color: var(--muted);
  text-decoration: none;
  transition: color 0.15s;
}
.nav-links a:hover,
.nav-links a[data-active] { color: var(--ink); }
.nav-cta {
  background: var(--accent);
  color: #fff !important;
  padding: 0.5rem 1.125rem;
  border-radius: 100px;
  transition: background 0.15s !important;
}
.nav-cta:hover { background: #8f74ff !important; color: #fff !important; }

/* ── Hero ──────────────────────────────────────────────────────── */
.hero-section {
  position: relative;
  padding-top: 120px;
  padding-bottom: 80px;
  overflow: hidden;
}
.hero-glow {
  position: absolute;
  inset: 0;
  background:
    radial-gradient(ellipse 50% 45% at 72% 42%, rgba(124,92,255,0.20) 0%, transparent 70%),
    radial-gradient(ellipse 35% 30% at 58% 78%, rgba(255,92,168,0.10) 0%, transparent 70%);
  pointer-events: none;
}
.hero-grid {
  position: relative;
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 2rem;
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: center;
  gap: 4rem;
  min-height: 80vh;
}
.hero-id {
  display: flex;
  align-items: center;
  gap: 1rem;
  margin-bottom: 2rem;
}
.hero-icon {
  width: 72px;
  height: 72px;
  border-radius: 18px;
  box-shadow: 0 12px 32px rgba(0,0,0,0.45);
  flex-shrink: 0;
}
.hero-name {
  font-family: 'Fraunces', Georgia, serif;
  font-size: 1.375rem;
  font-weight: 600;
  color: var(--ink);
  margin: 0;
  letter-spacing: -0.02em;
  line-height: 1.2;
}
.hero-kicker {
  font-size: 0.8125rem;
  color: var(--muted);
  margin: 0.15rem 0 0;
  line-height: 1.4;
}
.hero-headline {
  font-family: 'Fraunces', Georgia, serif;
  font-size: clamp(2.75rem, 6vw, 4.75rem);
  font-weight: 400;
  line-height: 1.05;
  letter-spacing: -0.03em;
  color: var(--ink);
  margin: 0 0 1.5rem;
}
.hero-headline em {
  font-style: italic;
  font-weight: 300;
  color: rgba(237,233,226,0.78);
}
.hero-sub {
  font-size: 1.0625rem;
  line-height: 1.65;
  color: var(--muted);
  max-width: 46ch;
  margin: 0 0 2.5rem;
}
.hero-actions {
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
}
.btn-primary {
  display: inline-flex;
  align-items: center;
  background: var(--accent);
  color: #fff;
  font-weight: 600;
  font-size: 0.9375rem;
  padding: 0.75rem 1.75rem;
  border-radius: 100px;
  text-decoration: none;
  transition: background 0.15s;
}
.btn-primary:hover { background: #8f74ff; }
.btn-primary--pending {
  background: rgba(124,92,255,0.14);
  color: #C9BAFF;
  border: 1.5px solid rgba(124,92,255,0.45);
  cursor: default;
}
.btn-primary--pending:hover { background: rgba(124,92,255,0.14); }
.btn-ghost {
  display: inline-flex;
  align-items: center;
  border: 1.5px solid rgba(237,233,226,0.15);
  color: var(--ink);
  font-weight: 500;
  font-size: 0.9375rem;
  padding: 0.75rem 1.75rem;
  border-radius: 100px;
  text-decoration: none;
  transition: border-color 0.15s;
}
.btn-ghost:hover { border-color: rgba(237,233,226,0.35); }
.hero-note {
  font-size: 0.8125rem;
  color: rgba(237,233,226,0.35);
  margin: 1.5rem 0 0;
}

.hero-visual {
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
  height: 560px;
}
.phone-stack {
  position: relative;
  width: 240px;
  height: 480px;
}
.phone {
  position: absolute;
  width: 220px;
  border-radius: 32px;
  overflow: hidden;
  box-shadow: 0 32px 80px rgba(0,0,0,0.55), 0 8px 24px rgba(0,0,0,0.35);
}
.phone img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: top;
  display: block;
}
.phone--back {
  top: 32px;
  left: -48px;
  height: 420px;
  transform: rotate(-6deg);
  opacity: 0.85;
  z-index: 1;
}
.phone--front {
  top: 0;
  left: 56px;
  height: 460px;
  transform: rotate(3deg);
  z-index: 2;
}

/* ── Proof strip ──────────────────────────────────────────────── */
.proof-strip {
  background: var(--navy);
  padding: 1.375rem 2rem;
  display: flex;
  align-items: center;
  gap: 2.5rem;
  flex-wrap: wrap;
}
.proof-label {
  font-size: 0.7rem;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.30);
  white-space: nowrap;
  margin: 0;
  flex-shrink: 0;
}
.proof-domains {
  display: flex;
  gap: 0;
  list-style: none;
  margin: 0; padding: 0;
  flex-wrap: wrap;
}
.proof-domains li {
  font-size: 0.8125rem;
  font-weight: 500;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.60);
  padding: 0 1.5rem;
  border-right: 1px solid rgba(255,255,255,0.10);
}
.proof-domains li:first-child { padding-left: 0; }
.proof-domains li:last-child { border-right: none; }

/* ── Sections ──────────────────────────────────────────────────── */
.section { padding: 100px 0; }
.section--navy { background: var(--navy); border-top: 1px solid rgba(237,233,226,0.05); }
.section-inner {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 2rem;
}
.section-header { margin-bottom: 4rem; max-width: 62ch; }
.eyebrow {
  display: block;
  font-size: 0.7rem;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--accent-2);
  margin-bottom: 0.75rem;
}
.eyebrow--accent { color: var(--accent-soft); }
.section-title {
  font-family: 'Fraunces', Georgia, serif;
  font-size: clamp(1.75rem, 3.5vw, 2.75rem);
  font-weight: 400;
  letter-spacing: -0.025em;
  color: var(--ink);
  margin: 0;
  line-height: 1.15;
}
.section-lede {
  font-size: 1.0625rem;
  line-height: 1.65;
  color: rgba(237,233,226,0.50);
  margin: 1.25rem 0 0;
}
.section-lede a {
  color: var(--ink);
