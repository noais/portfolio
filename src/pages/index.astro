---
import Layout from '../layouts/Layout.astro';

const experience = [
  {
    period: '2025 — Present',
    role: 'Head of Mobile / Lead Engineer',
    company: 'FRiNGE',
    outcomes: [
      'Built location-based livestreaming iOS product end-to-end — Swift 6/SwiftUI, Agora RTC, Supabase, PostHog',
      'Shipped from zero to TestFlight in 9 weeks; real-time camera/RTC handoff with zero reported crashes',
      'Led full mobile architecture decision-making across product, backend, and infra',
    ],
  },
  {
    period: '2023 — 2025',
    role: 'Lead iOS Developer',
    company: 'Volkswagen Group',
    outcomes: [
      'Automotive platform architecture and release flows across European vehicle models',
      'Technical alignment across 4+ cross-functional squads; reduced release cycle from 3 weeks to 10 days',
      'Built internal tooling (Python, Bash, YAML) that automated 60% of manual release prep steps',
    ],
  },
  {
    period: '2021 — 2023',
    role: 'Senior iOS Developer',
    company: 'Mindera / Vodafone & MEO',
    outcomes: [
      'Led telecom iOS product serving 1M+ subscribers — zero Sev-1 incidents across 18-month engagement',
      'Introduced TCA architecture pattern adopted by 3 other squads in the org',
      'Mentored 4 mid-level engineers; 2 promoted to senior within the engagement',
    ],
  },
  {
    period: '2018 — 2021',
    role: 'iOS Developer',
    company: 'Various (agencies & products)',
    outcomes: [
      'Delivered 8+ iOS products across smart home, fintech, health, and outdoor sports verticals',
      'Introduced unit test coverage baseline that became studio-wide standard at two agencies',
    ],
  },
];

const capabilities = [
  {
    label: 'Mobile Product Engineering',
    items: ['iOS & Swift', 'Android & Kotlin', 'SwiftUI & UIKit', 'App Store / Play Store'],
  },
  {
    label: 'Real-time & Platform',
    items: ['WebSockets / MQTT', 'Swift Concurrency', 'Offline-first architecture', 'BLE & background modes'],
  },
  {
    label: 'AI-Augmented Delivery',
    items: ['LLM-assisted code review', 'Automated test generation', 'Claude API integration', 'AI pair-programming'],
  },
  {
    label: 'Leadership & Quality',
    items: ['Engineering management', 'Hiring & levelling', 'Architecture review', 'Cross-functional delivery'],
  },
];

const proofDomains = ['Automotive', 'Smart Home', 'Secure Messaging', 'Health', 'Telecom', 'Outdoor Sports'];
---

<Layout
  title="David Ferreira — Mobile products built to hold up."
  description="David Ferreira designs and leads durable iOS and Android products—from real-time experiences to the systems that keep teams shipping."
>

<!-- ─── NAV ─────────────────────────────────────────────────────── -->
<header class="nav-shell">
  <nav class="nav-inner">
    <a href="#top" class="nav-logo">DF</a>
    <ul class="nav-links">
      <li><a href="#work" data-nav="work">Work</a></li>
      <li><a href="#experience" data-nav="experience">Experience</a></li>
      <li><a href="#capabilities" data-nav="capabilities">Capabilities</a></li>
      <li><a href="/carpeit/">CarpeIt</a></li>
      <li><a href="/nursling/">Nursling</a></li>
      <li><a href="/ai-consulting/">AI Consulting</a></li>
      <li><a href="#contact" data-nav="contact" class="nav-cta">Let's talk</a></li>
    </ul>
  </nav>
</header>

<!-- ─── HERO ──────────────────────────────────────────────────────── -->
<section id="top" class="hero-section">
  <div class="hero-grid">

    <!-- Left: copy -->
    <div class="hero-copy">
      <div class="hero-chips">
        <span class="chip">16+ yrs</span>
        <span class="chip">iOS · Android</span>
        <span class="chip">Portugal</span>
      </div>

      <h1 class="hero-headline">
        Mobile products<br />
        <em>built to hold up.</em>
      </h1>

      <p class="hero-sub">
        David Ferreira designs and leads durable iOS and Android products —
        from real-time experiences to the systems that keep teams shipping.
      </p>

      <div class="hero-actions">
        <a href="#work" class="btn-primary">See the work</a>
        <a href="#contact" class="btn-ghost">Let's talk</a>
      </div>
    </div>

    <!-- Right: phone composition -->
    <div class="hero-visual" aria-hidden="true">
      <div class="hero-topo"></div>
      <div class="phone-fan">
        <div class="device device--left">
          <img src="/carpeit/screen-explore.webp" alt="" width="659" height="1434" loading="eager" />
        </div>
        <div class="device device--right">
          <img src="/carpeit/screen-map.webp" alt="" width="659" height="1434" loading="eager" />
        </div>
        <div class="device device--center">
          <img src="/carpeit/screen-detail.webp" alt="" width="659" height="1434" loading="eager" fetchpriority="high" />
        </div>
      </div>
      <p class="hero-caption"><span class="status-dot"></span>Now building · CarpeIt for iPhone</p>
    </div>

  </div>
</section>

<!-- ─── PROOF STRIP ───────────────────────────────────────────────── -->
<div class="proof-strip">
  <p class="proof-label">Built across</p>
  <ul class="proof-domains">
    {proofDomains.map((d) => (
      <li>{d}</li>
    ))}
  </ul>
</div>

<!-- ─── WORK ──────────────────────────────────────────────────────── -->
<section id="work" class="section">
  <div class="section-inner">
    <div class="section-header">
      <span class="eyebrow">Selected work</span>
      <h2 class="section-title">Products that ship and stay shipped.</h2>
    </div>

    <!-- CarpeIt — flagship -->
    <article class="case-card case-card--flagship">
      <div class="case-screens">
        <div class="case-phone case-phone--1">
          <img src="/carpeit/screen-explore.webp" alt="CarpeIt Explore feed with rentable wing and kite gear, priced per day" width="659" height="1434" loading="lazy" />
        </div>
        <div class="case-phone case-phone--2">
          <img src="/carpeit/screen-detail.webp" alt="CarpeIt listing for a Duotone Rebel SLS 9m kite at €50 a day, with a Check availability button" width="659" height="1434" loading="lazy" />
        </div>
        <div class="case-phone case-phone--3">
          <img src="/carpeit/screen-map.webp" alt="CarpeIt map search with price pins along the Aveiro coast" width="659" height="1434" loading="lazy" />
        </div>
      </div>

      <div class="case-body">
        <div class="case-meta">
          <span class="case-tag">iOS · Marketplace · Payments</span>
          <span class="status-pill"><span class="status-dot"></span>In development</span>
        </div>
        <h3 class="case-title">CarpeIt</h3>
        <p class="case-lede">
          Kites, boards and foils are expensive, bulky and situational. CarpeIt is a peer-to-peer marketplace for kitesurf, surf, wing foil and SUP gear. One account can both rent and lend.
        </p>
        <ul class="case-highlights">
          <li><strong>Map search</strong> with price pins on the coast you ride</li>
          <li><strong>Stripe checkout</strong> with deposits kept separate from the total</li>
          <li><strong>Photo inspections</strong> at pickup and return</li>
          <li><strong>Pro dashboard</strong> for schools and shops</li>
        </ul>
        <div class="case-stack">
          <span>Swift 6</span><span>SwiftUI</span><span>Supabase</span><span>Stripe Connect</span><span>MapKit</span><span>Realtime</span>
        </div>
        <a href="/carpeit/" class="case-link">
          See CarpeIt <span aria-hidden="true">→</span>
        </a>
      </div>
    </article>

    <!-- RidersNow — secondary -->
    <article class="case-card case-card--secondary">
      <div class="case-screen-single">
        <img src="/work/ridersnow-live.webp" alt="RidersNow live map showing riders at nearby spots" width="660" height="1428" loading="lazy" />
      </div>
      <div class="case-body">
        <span class="case-tag">iOS · Android · Real-time · Outdoor Sports</span>
        <h3 class="case-title">RidersNow</h3>
        <p class="case-problem">
          <strong>Problem:</strong> Outdoor sports riders had no way to find or coordinate sessions in real time — events were stale by the time they were shared.
        </p>
        <p class="case-outcome">
          <strong>Outcome:</strong> Live map matching, BLE proximity detection, and push-coordinated sessions. Shipped cross-platform in 14 weeks, zero critical post-launch incidents.
        </p>
        <div class="case-stack">
          <span>Swift</span><span>Kotlin</span><span>WebSockets</span><span>BLE</span><span>MQTT</span>
        </div>
        <a href="/ridersnow-site/" target="_blank" rel="noopener" class="case-link">
          Visit RidersNow <span aria-hidden="true">↗</span>
        </a>
      </div>
    </article>

    <!-- MyLedgerAI — secondary -->
    <article class="case-card case-card--secondary">
      <div class="case-screen-single">
        <img src="/work/myledger-overview.webp" alt="MyLedgerAI overview screen with balance, budgets and spending chart" width="660" height="1434" loading="lazy" />
      </div>
      <div class="case-body">
        <span class="case-tag">iOS · Personal Finance · AI</span>
        <h3 class="case-title">MyLedgerAI</h3>
        <p class="case-problem">
          <strong>Problem:</strong> Traditional finance apps track what happened, but rarely turn that data into useful context for what to do next.
        </p>
        <p class="case-outcome">
          <strong>Outcome:</strong> A privacy-first, chat-led financial companion that connects transactions, budgets, goals, forecasts, and scanned receipts to deliver grounded guidance. Built with on-device storage, RAG-powered context, receipt OCR, and exportable financial reports.
        </p>
        <div class="case-stack">
          <span>Swift</span><span>SwiftUI</span><span>SwiftData</span><span>RAG</span><span>Vision OCR</span>
        </div>
      </div>
    </article>

    <!-- Nursling — secondary -->
    <article class="case-card case-card--secondary">
      <div class="case-screen-single">
        <img src="/work/nursling-home.webp" alt="Nursling home screen showing time since the last nursing" width="660" height="1434" loading="lazy" />
      </div>
      <div class="case-body">
        <span class="case-tag">iOS · watchOS · Health · Personal Product</span>
        <h3 class="case-title">Nursling</h3>
        <p class="case-problem">
          <strong>Problem:</strong> Baby trackers are built for the daytime version of a parent. At 3am, with one hand free, every picker, confirmation and "which side?" question is a reason to stop logging.
        </p>
        <p class="case-outcome">
          <strong>Outcome:</strong> A breastfeeding tracker scoped down to a single tap that already knows which breast comes next. The same App Intent ships to the widget, Control Centre, the Action Button, Siri, a Live Activity and an Apple Watch app, so a session starts without opening anything. No account, no server, no analytics — records stay in a local store, exportable to CSV. Shipped solo in 21 languages.
        </p>
        <div class="case-stack">
          <span>Swift 6</span><span>SwiftUI</span><span>App Intents</span><span>WidgetKit</span><span>SQLite</span><span>watchOS</span>
        </div>
        <a href="/nursling/" class="case-link">
          See Nursling <span aria-hidden="true">→</span>
        </a>
      </div>
    </article>

  </div>
</section>

<!-- ─── EXPERIENCE ─────────────────────────────────────────────────── -->
<section id="experience" class="section section--navy">
  <div class="section-inner">
    <div class="section-header section-header--light">
      <span class="eyebrow eyebrow--lime">Experience</span>
      <h2 class="section-title section-title--light">Outcomes, not job descriptions.</h2>
    </div>

    <ol class="timeline">
      {experience.map((role) => (
        <li class="timeline-item">
          <div class="timeline-meta">
            <span class="timeline-period">{role.period}</span>
          </div>
          <div class="timeline-body">
            <p class="timeline-role">{role.role}</p>
            <p class="timeline-company">{role.company}</p>
            <ul class="timeline-outcomes">
              {role.outcomes.map((o) => (
                <li>{o}</li>
              ))}
            </ul>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<!-- ─── CAPABILITIES ──────────────────────────────────────────────── -->
<section id="capabilities" class="section">
  <div class="section-inner">
    <div class="section-header section-header--light">
      <span class="eyebrow eyebrow--lime">Capabilities</span>
      <h2 class="section-title section-title--light">The full stack of mobile delivery.</h2>
    </div>

    <div class="caps-grid">
      {capabilities.map((cap) => (
        <div class="cap-panel">
          <h3 class="cap-title">{cap.label}</h3>
          <ul class="cap-items">
            {cap.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ─── CONTACT ───────────────────────────────────────────────────── -->
<section id="contact" class="section section--navy">
  <div class="section-inner">
    <div class="contact-card">
      <span class="eyebrow eyebrow--lime">Contact</span>
      <h2 class="contact-headline">
        Building a mobile product that needs to hold up under pressure?
      </h2>
      <p class="contact-sub">
        Available for senior engineering and engineering-lead roles. Based in Portugal, open to remote or hybrid across Europe.
      </p>
      <div class="contact-links">
        <a href="mailto:hey@davidferreira.dev" class="contact-link contact-link--primary">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 7 10-7"/></svg>
          hey@davidferreira.dev
        </a>
        <a href="https://www.linkedin.com/in/david-ferreira-69041367" target="_blank" rel="noopener" class="contact-link">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="2" width="20" height="20" rx="3"/><path d="M7 10v7M7 7v.01M12 17v-4a2 2 0 0 1 4 0v4M12 10v7"/></svg>
          LinkedIn
        </a>
        <a href="https://github.com/noais" target="_blank" rel="noopener" class="contact-link">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>
          GitHub
        </a>
      </div>
    </div>
  </div>
</section>

<!-- ─── FOOTER ────────────────────────────────────────────────────── -->
<footer class="footer">
  <p>David Ferreira · Portugal · <span id="year"></span></p>
  <script>document.getElementById('year').textContent = new Date().getFullYear().toString();</script>
</footer>

</Layout>

<style>
/* ── Nav ───────────────────────────────────────────────────────── */
.nav-shell {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 100;
  background: rgba(13,15,26,0.85);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border-bottom: 1px solid rgba(237,233,226,0.07);
}
.nav-inner {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 2rem;
  height: 60px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.nav-logo {
  font-family: 'Fraunces', Georgia, serif;
  font-size: 1.25rem;
  font-weight: 600;
  color: var(--ink);
  text-decoration: none;
  letter-spacing: -0.02em;
}
.nav-links {
  display: flex;
  align-items: center;
  gap: 2rem;
  list-style: none;
  margin: 0; padding: 0;
}
.nav-links a {
  font-size: 0.875rem;
  font-weight: 500;
  color: var(--muted);
  text-decoration: none;
  white-space: nowrap;
  transition: color 0.15s;
}
.nav-links a:hover,
.nav-links a[data-active] { color: var(--ink); }
.nav-cta {
  background: var(--lime);
  color: #0D0F1A !important;
  padding: 0.5rem 1.125rem;
  border-radius: 100px;
  transition: background 0.15s !important;
}
.nav-cta:hover { background: #d4ff3a !important; color: #0D0F1A !important; }

/* ── Hero ──────────────────────────────────────────────────────── */
.hero-section {
  position: relative;
  padding-top: 132px;
  padding-bottom: 96px;
  overflow: hidden;
}
/* Faint dot grid, faded out towards the edges */
.hero-section::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image: radial-gradient(rgba(237,233,226,0.10) 1px, transparent 1px);
  background-size: 28px 28px;
  mask-image: radial-gradient(ellipse 70% 60% at 60% 45%, #000 20%, transparent 75%);
  -webkit-mask-image: radial-gradient(ellipse 70% 60% at 60% 45%, #000 20%, transparent 75%);
  pointer-events: none;
}
.hero-grid {
  position: relative;
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 2rem;
  display: grid;
  grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
  align-items: center;
  gap: 3rem;
}
.hero-chips {
  display: flex;
  gap: 0.5rem;
  margin-bottom: 2rem;
  flex-wrap: wrap;
}
.chip {
  font-size: 0.75rem;
  font-weight: 500;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: var(--muted);
  border: 1px solid rgba(237,233,226,0.10);
  border-radius: 100px;
  padding: 0.3rem 0.875rem;
  background: rgba(237,233,226,0.04);
}
.hero-headline {
  font-family: 'Fraunces', Georgia, serif;
  font-size: clamp(2.75rem, 5.4vw, 4.75rem);
  font-weight: 400;
  line-height: 1.02;
  letter-spacing: -0.035em;
  color: var(--ink);
  margin: 0 0 1.5rem;
  text-wrap: balance;
}
.hero-headline em {
  font-style: italic;
  font-weight: 300;
  color: var(--lime);
}
.hero-sub {
  font-size: 1.0625rem;
  line-height: 1.65;
  color: var(--muted);
  max-width: 44ch;
  margin: 0 0 2.5rem;
}
.hero-actions {
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
}
.btn-primary {
  display: inline-flex;
  align-items: center;
  background: var(--lime);
  color: #0D0F1A;
  font-weight: 600;
  font-size: 0.9375rem;
  padding: 0.75rem 1.75rem;
  border-radius: 100px;
  text-decoration: none;
  transition: background 0.15s, transform 0.15s, box-shadow 0.15s;
}
.btn-primary:hover { background: #d4ff3a; transform: translateY(-1px); box-shadow: 0 10px 30px rgba(198,241,53,0.25); }
.btn-ghost {
  display: inline-flex;
  align-items: center;
  border: 1.5px solid rgba(237,233,226,0.15);
  color: var(--ink);
  font-weight: 500;
  font-size: 0.9375rem;
  padding: 0.75rem 1.75rem;
  border-radius: 100px;
  text-decoration: none;
  transition: border-color 0.15s;
}
.btn-ghost:hover { border-color: rgba(237,233,226,0.35); }

/* Phone fan */
.hero-visual {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 600px;
}
.phone-fan {
  position: relative;
  width: 100%;
  max-width: 480px;
  height: 560px;
}
.device {
  position: absolute;
  top: 50%;
  left: 50%;
  aspect-ratio: 659 / 1434;
  border-radius: 38px;
  padding: 6px;
  background: linear-gradient(160deg, #2a2e3b, #0b0d14 60%);
  box-shadow:
    0 0 0 1px rgba(237,233,226,0.10),
    0 40px 90px rgba(0,0,0,0.60),
    0 12px 30px rgba(0,0,0,0.40);
}
.device img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 32px;
}
.device--center {
  width: 250px;
  transform: translate(-50%, -50%);
  z-index: 3;
}
.device--left {
  width: 210px;
  transform: translate(-112%, -46%) rotate(-7deg);
  z-index: 1;
  filter: brightness(0.72);
}
.device--right {
  width: 210px;
  transform: translate(12%, -46%) rotate(7deg);
  z-index: 2;
  filter: brightness(0.72);
}
.hero-topo {
  position: absolute;
  inset: -10% -20%;
  background:
    radial-gradient(ellipse 45% 40% at 50% 50%, rgba(198,241,53,0.12) 0%, transparent 70%),
    radial-gradient(ellipse 40% 35% at 70% 30%, rgba(57,198,189,0.10) 0%, transparent 70%);
  pointer-events: none;
  z-index: 0;
}
.hero-caption {
  position: relative;
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  margin: 1.5rem 0 0;
  font-size: 0.8125rem;
  color: rgba(237,233,226,0.62);
  background: rgba(237,233,226,0.04);
  border: 1px solid rgba(237,233,226,0.09);
  border-radius: 100px;
  padding: 0.35rem 0.9rem;
  backdrop-filter: blur(8px);
}
.status-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--lime);
  box-shadow: 0 0 0 0 rgba(198,241,53,0.6);
  animation: pulse 2.4s ease-out infinite;
  flex-shrink: 0;
}
@keyframes pulse {
  0%   { box-shadow: 0 0 0 0 rgba(198,241,53,0.55); }
  70%  { box-shadow: 0 0 0 8px rgba(198,241,53,0); }
  100% { box-shadow: 0 0 0 0 rgba(198,241,53,0); }
}

/* ── Proof strip ──────────────────────────────────────────────── */
.proof-strip {
  background: var(--navy);
  padding: 1.375rem 2rem;
  display: flex;
  align-items: center;
  gap: 2.5rem;
  flex-wrap: wrap;
}
.proof-label {
  font-size: 0.7rem;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.50);
  white-space: nowrap;
  margin: 0;
  flex-shrink: 0;
}
.proof-domains {
  display: flex;
  gap: 0;
  list-style: none;
  margin: 0; padding: 0;
  flex-wrap: wrap;
}
.proof-domains li {
  font-size: 0.8125rem;
  font-weight: 500;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.60);
  padding: 0 1.5rem;
  border-right: 1px solid rgba(255,255,255,0.10);
}
.proof-domains li:first-child { padding-left: 0; }
.proof-domains li:last-child { border-right: none; }

/* ── Sections ──────────────────────────────────────────────────── */
.section {
  padding: 100px 0;
}
.section--navy { background: var(--navy); border-top: 1px solid rgba(237,233,226,0.05); }
.section-inner {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 2rem;
}
.section-header { margin-bottom: 4rem; }
.section-header--light .section-title { color: #fff; }
.eyebrow {
  display: block;
  font-size: 0.7rem;
