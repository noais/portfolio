---
import Layout from '../../layouts/Layout.astro';
import { velkoOperator, complaintsBookUrl } from '../../data/velkoOperator';
import { commissionTiers, exampleRentalPrice, formatEuro, ownerReceives, pricingFaqs, standardTier, currentRateNote, existingBookingSummary, foundingApplicationsOpen } from '../../data/velkoPricing';

const strip = ['Kitesurf', 'Surf', 'Wing foil', 'SUP', 'Riders', 'Schools & shops'];

const features = [
  {
    title: 'Search the map, not a group chat',
    body: 'Price pins on the coast you ride, with a list view and filters for sport and dates. Browsing works without an account.',
  },
  {
    title: 'Listings that know the sport',
    body: 'A kite is listed by size, a board by volume. The listing wizard asks only for what matters to that category and saves your draft as you go.',
  },
  {
    title: 'Money shown honestly',
    body: 'Rental total, deposit and owner payout are always separate lines. The deposit is held, never added to the rental price, and owners see their commission and exactly what they receive before they publish.',
  },
  {
    title: 'Condition on the record',
    body: 'Guided photo checks at pickup and return. A handover only completes once the evidence has uploaded, so both sides share the same record.',
  },
  {
    title: 'Plans made in the app',
    body: 'Real-time chat for every booking, with the rental pinned to the top of the conversation, so pickup times do not get lost.',
  },
  {
    title: 'Pro for schools and shops',
    body: 'A dashboard for rental fleets: today’s pickups and returns, active rentals, estimated payout and what needs attention.',
  },
];

const screens = [
  {
    src: '/velko/screen-explore.webp',
    title: 'Browse what’s nearby',
    body: 'Gear from riders, schools and shops, with the day price up front.',
    alt: 'Velko Explore feed with a Duotone Rebel SLS 9m kite at €50 a day and sport filters',
  },
  {
    src: '/velko/screen-map.webp',
    title: 'Search the coast',
    body: 'Price pins along the spots you ride, with a list view one tap away.',
    alt: 'Velko map search with price pins around Aveiro and a Duotone Rebel SLS preview card',
  },
  {
    src: '/velko/screen-detail.webp',
    title: 'Know what you’re getting',
    body: 'Sport-specific specs, condition and owner rating before you book.',
    alt: 'Velko listing for a Duotone Rebel SLS 9m kite at €50 a day',
  },
  {
    src: '/velko/screen-dates.webp',
    title: 'Pick your days',
    body: 'Live availability and an honest total before checkout.',
    alt: 'Velko availability calendar with 16 to 18 October selected and a Continue · €100 button',
  },
  {
    src: '/velko/screen-explore2.webp',
    title: 'Follow the water',
    body: 'A map preview and editorial moments that keep the feed feeling like the beach.',
    alt: 'Velko Explore map preview with prices and a “Find your gear. Follow the water.” card',
  },
];

const roles = [
  {
    tier: 'Renting',
    headline: 'The right gear for the conditions',
    points: [
      'Find a kite, board or foil near the spot you’re riding',
      'Pick dates on the owner’s live availability',
      'Pay in-app, with the deposit shown on its own',
      'Photo check at pickup and return',
    ],
  },
  {
    tier: 'Lending',
    headline: 'Earn from the gear you’re not using',
    points: [
      'List in minutes, with forms built for each sport',
      'Choose exactly when your gear is available',
      'See your commission and payout before you publish',
      'Get paid out through Stripe',
    ],
    accent: true,
  },
  {
    tier: 'Schools & shops',
    headline: 'Your fleet, in front of local riders',
    points: [
      'The same marketplace, with no new booking system to learn',
      'Multiple units and fleet availability',
      'A daily view of pickups, returns and payouts',
    ],
  },
];

const build = [
  { label: 'App', items: ['Swift 6', 'SwiftUI', 'iOS 17+', 'MVVM + typed coordinator', 'Modular Swift packages'] },
  { label: 'Backend', items: ['Supabase Postgres', 'Edge Functions', 'Realtime', 'Storage'] },
  { label: 'Payments', items: ['Stripe PaymentSheet', 'Stripe Connect payouts', 'Deposit holds', 'Webhooks'] },
  { label: 'Craft', items: ['Sign in with Apple & email code', 'Offline-safe upload queue', 'Reduce Motion–aware motion', 'Dark mode'] },
];

const ownerTypes = [
  {
    tier: 'Riders',
    headline: 'Spare kite, board or foil?',
    points: [
      'List it in minutes, with a form built for that sport',
      'You choose the price, the deposit and the dates',
      'Condition photos at every pickup and return',
    ],
  },
  {
    tier: 'Schools & shops',
    headline: 'Put your rental fleet on the map',
    points: [
      'Reach riders searching the coast you’re on',
      'Multiple units, fleet availability and a daily dashboard',
      'Payouts through Stripe, and a reduced Volume Partner rate if you qualify',
    ],
    accent: true,
  },
];

const listMail = `mailto:${velkoOperator.email}?subject=${encodeURIComponent('Listing my gear on Velko')}`;

const app = {
  '@type': 'SoftwareApplication',
  name: 'Velko',
  operatingSystem: 'iOS, Android',
  applicationCategory: 'LifestyleApplication',
  inLanguage: 'en',
  url: 'https://davidferreira.dev/velko/',
  image: 'https://davidferreira.dev/velko/og.png',
  description:
    'A peer-to-peer rental marketplace for kitesurf, surf, wing foil and SUP gear in Portugal. Rent from local riders, schools and shops, or earn from the gear you are not using.',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
  author: { '@type': 'Person', name: 'David Ferreira', url: 'https://davidferreira.dev' },
  publisher: {
    '@type': 'Organization',
    name: velkoOperator.name,
    email: velkoOperator.email,
    address: velkoOperator.address,
  },
};

// Mirrors the visible FAQ below, question for question.
const faqPage = {
  '@type': 'FAQPage',
  url: 'https://davidferreira.dev/velko/#faq',
  mainEntity: pricingFaqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [app, faqPage],
};
---

<Layout
  title="Velko — rent water sports gear from local riders."
  description="Velko is a peer-to-peer rental marketplace for kitesurf, surf, wing foil and SUP gear in Portugal. Rent from local riders, schools and shops with no renter fees — or list your gear for free and earn when it’s rented."
  keywords="water sports gear rental, kitesurf rental, surfboard rental, wing foil rental, SUP rental, peer-to-peer marketplace, list gear for free, earn from your gear, rental commission, Portugal, iOS app, Android app, Velko"
  structuredData={structuredData}
  siteName="Velko"
  locale="en_GB"
  ogImage="/velko/og.png"
  ogImageAlt="Velko — rent water sports gear from local riders, schools and shops, or list yours for free"
  twitterCard="summary_large_image"
  favicon="/velko/favicon-64.png"
  appleTouchIcon="/velko/apple-touch-icon.png"
>

<!-- ─── NAV ─────────────────────────────────────────────────────── -->
<header class="nav-shell">
  <nav class="nav-inner">
    <a href="/" class="nav-logo">DF</a>
    <ul class="nav-links">
      <li class="nav-wide"><a href="#inside" data-nav="inside">Screens</a></li>
      <li class="nav-wide"><a href="#features" data-nav="features">Features</a></li>
      <li><a href="#how" data-nav="how">How it works</a></li>
      <li><a href="#list" data-nav="list">List your gear</a></li>
      <li><a href="#pricing" data-nav="pricing">Pricing</a></li>
      <li><a href="#faq" data-nav="faq">FAQ</a></li>
      <li class="nav-wide"><a href="#build" data-nav="build">Build</a></li>
      <li><a href="/">Portfolio</a></li>
      <li><a href="#contact" class="nav-cta">Get in touch</a></li>
    </ul>
  </nav>
</header>

<!-- ─── HERO ──────────────────────────────────────────────────────── -->
<section id="top" class="hero-section">
  <div class="hero-glow" aria-hidden="true"></div>
  <div class="hero-grid">

    <div class="hero-copy">
      <div class="hero-id">
        <img src="/velko/app-icon.png" alt="Velko app icon" class="hero-icon" width="72" height="72" />
        <div>
          <p class="hero-name">Velko</p>
          <p class="hero-kicker">Water sports gear rental · Launching in Portugal</p>
        </div>
      </div>

      <h1 class="hero-headline">
        Less owning.<br />
        <em>More riding.</em>
      </h1>

      <p class="hero-sub">
        Rent great gear from local riders, schools and shops — or share yours. Velko is a
        peer-to-peer marketplace for kitesurf, surf, wing foil and SUP, built around trust:
        honest totals, separate deposits, and condition photos at every handover.
      </p>

      <div class="hero-actions">
        <span class="status-pill"><span class="status-dot"></span>Coming soon to the App Store and Google Play</span>
        <a href="#how" class="btn-ghost">See how it works</a>
      </div>
    </div>

    <div class="hero-visual" aria-hidden="true">
      <div class="phone-stack">
        <div class="phone phone--back">
          <img src="/velko/screen-explore.webp" alt="" width="659" height="1434" loading="eager" />
        </div>
        <div class="phone phone--front">
          <img src="/velko/welcome.webp" alt="" width="659" height="1434" loading="eager" fetchpriority="high" />
        </div>
      </div>
    </div>

  </div>
</section>

<!-- ─── PROOF STRIP ───────────────────────────────────────────────── -->
<div class="proof-strip">
  <p class="proof-label">Built for</p>
  <ul class="proof-domains">
    {strip.map((s) => (
      <li>{s}</li>
    ))}
  </ul>
</div>

<!-- ─── PREMISE ───────────────────────────────────────────────────── -->
<section id="premise" class="section">
  <div class="section-inner premise-grid">
    <div class="premise-copy">
      <span class="eyebrow">The premise</span>
      <h2 class="premise-headline">
        Great gear spends most of the year in a garage.
      </h2>
      <p class="premise-body">
        Water sports equipment is expensive, bulky and situational. Riders travel without the
        right kite or board for the conditions, while other riders have spare sizes that barely
        get wet. Schools and shops have gear to rent, but finding it means websites, WhatsApp
        and phone calls. Velko puts all of it on one map, bookable in minutes, with the trust
        built in that lending your own gear to a stranger needs.
      </p>
      <div class="premise-stats">
        <div class="premise-stat">
          <span class="premise-num">4</span>
          <span class="premise-cap">sports at launch: kite, surf, wing, SUP</span>
        </div>
        <div class="premise-stat">
          <span class="premise-num">1</span>
          <span class="premise-cap">account to both rent and lend</span>
        </div>
        <div class="premise-stat">
          <span class="premise-num">2</span>
          <span class="premise-cap">photo checks per rental, at pickup and return</span>
        </div>
      </div>
    </div>

    <div class="premise-visual">
      <div class="premise-phone">
        <img
          src="/velko/screen-detail.webp"
          alt="Velko listing for a Duotone Rebel SLS 9m kite in Costa Nova at €50 a day, with condition, discipline and a Check availability button"
          loading="lazy"
          width="659"
          height="1434"
        />
      </div>
    </div>
  </div>
</section>

<!-- ─── INSIDE THE APP ────────────────────────────────────────────── -->
<section id="inside" class="section section--navy">
  <div class="section-inner">
    <div class="section-header">
      <span class="eyebrow eyebrow--accent">Inside the app</span>
      <h2 class="section-title">From the map to the water in a few taps.</h2>
    </div>
  </div>
  <ol class="gallery" aria-label="Velko screens">
    {screens.map((sc, i) => (
      <li class="gallery-item">
        <div class="gallery-phone">
          <img src={sc.src} alt={sc.alt} width="659" height="1434" loading="lazy" />
        </div>
        <p class="gallery-step">{String(i + 1).padStart(2, '0')}</p>
        <h3 class="gallery-title">{sc.title}</h3>
        <p class="gallery-body">{sc.body}</p>
      </li>
    ))}
  </ol>
</section>

<!-- ─── FEATURES ──────────────────────────────────────────────────── -->
<section id="features" class="section">
  <div class="section-inner">
    <div class="section-header">
      <span class="eyebrow eyebrow--accent">What it does</span>
      <h2 class="section-title">Trust before growth hacks.</h2>
      <p class="section-lede">
        Condition photos, clear deposits and transparent payouts matter more than urgency
        banners. Every flow in Velko is designed so both sides know exactly what they are
        agreeing to.
      </p>
    </div>

    <div class="surface-grid">
      {features.map((f) => (
        <div class="surface-panel">
          <h3 class="surface-title">{f.title}</h3>
          <p class="surface-body">{f.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ─── HOW IT WORKS ──────────────────────────────────────────────── -->
<section id="how" class="section section--navy">
  <div class="section-inner">
    <div class="section-header">
      <span class="eyebrow">How it works</span>
      <h2 class="section-title">The gear you rent. The gear you share.</h2>
    </div>

    <div class="price-grid price-grid--3">
      {roles.map((r) => (
        <div class={r.accent ? 'price-card price-card--accent' : 'price-card'}>
          <p class="price-tier">{r.tier}</p>
          <p class="price-amount">{r.headline}</p>
          <ul class="price-points">
            {r.points.map((p) => (
              <li>{p}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ─── LIST YOUR GEAR ────────────────────────────────────────────── -->
<section id="list" class="section">
  <div class="section-inner">
    <div class="section-header">
      <span class="eyebrow eyebrow--accent">For owners</span>
      <h2 class="section-title">List your equipment for free. Earn when someone rents it.</h2>
      <p class="section-lede">
        That spare kite, the board that only comes out in big swell, the SUPs stacked at the back
        of the school: most gear spends more days dry than wet. Velko puts it in front of riders
        searching the coast you’re on, so it earns while you’re not using it. Listing is free,
        there’s no subscription, and Velko only takes a commission when a rental goes ahead —
        you see exactly what you’ll receive before you publish. We’re onboarding the first
        riders, schools and shops in Portugal ahead of launch.
      </p>
    </div>

    <div class="price-grid">
      {ownerTypes.map((r) => (
        <div class={r.accent ? 'price-card price-card--accent' : 'price-card'}>
          <p class="price-tier">{r.tier}</p>
          <p class="price-amount">{r.headline}</p>
          <ul class="price-points">
            {r.points.map((p) => (
              <li>{p}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="hero-actions list-actions">
      <a href={listMail} class="btn-primary">{foundingApplicationsOpen ? 'Ask about Founding Partner eligibility' : 'Tell us about your gear'}</a>
      <a href="/velko/terms/" class="btn-ghost">Read the owner terms</a>
    </div>
  </div>
</section>

<!-- ─── PRICING ───────────────────────────────────────────────────── -->
<section id="pricing" class="section section--navy">
  <div class="section-inner">
    <div class="section-header">
      <span class="eyebrow eyebrow--accent">Pricing for owners</span>
      <h2 class="section-title">One simple commission. Nothing upfront.</h2>
      <p class="section-lede">
        Every owner starts as a Standard Partner at {standardTier.percent}%.
        Rental businesses, schools, clubs and early partners can apply for a reduced rate.
        Renters pay the price shown — no service fee on top. {currentRateNote}
        {existingBookingSummary} <a href="/velko/terms/#owner-fees">See eligibility and fee details.</a>
      </p>
    </div>

    <div class="price-grid price-grid--3">
      {commissionTiers.map((t) => (
        <div class={t.isDefault ? 'price-card price-card--accent tier-card' : 'price-card tier-card'}>
          <p class="price-tier">{t.name}</p>
          <p class="tier-badge">{t.badge}</p>
          <p class="price-amount tier-rate">
            <span class="tier-percent">{t.percent}%</span> commission
          </p>
          <ul class="price-points">
            {t.bullets.map((b) => (
              <li>{b}</li>
            ))}
          </ul>
          <p class="tier-example">
            <span>{formatEuro(exampleRentalPrice)} rental</span>
            <span aria-hidden="true">→</span>
            <span>you receive <strong>{formatEuro(ownerReceives(t))}</strong></span>
          </p>
        </div>
      ))}
    </div>

    <p class="tier-note">
      The commission is everything Velko takes from you: any VAT due is included, and Stripe’s
      card processing fees are paid by Velko out of its commission. Payouts reach your bank on
      Stripe’s payout schedule. Volume and Founding rates are by approval; Founding Partner
      eligibility and duration follow the published programme terms.
      See <a href="/velko/terms/">the Terms, section 6</a>.
    </p>
  </div>
</section>

<!-- ─── FAQ ───────────────────────────────────────────────────────── -->
<section id="faq" class="section">
  <div class="section-inner">
    <div class="section-header">
      <span class="eyebrow eyebrow--accent">FAQ</span>
      <h2 class="section-title">Commission and payouts, answered.</h2>
    </div>

    <div class="faq">
      {pricingFaqs.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
          {f.link && <p><a href={f.link.href}>{f.link.label}</a></p>}
        </details>
      ))}
    </div>

    <p class="tier-note">
      More questions about renting, deposits or handovers? See <a href="/velko/support/">Support</a>.
    </p>
  </div>
</section>

<!-- ─── BUILD ─────────────────────────────────────────────────────── -->
<section id="build" class="section">
  <div class="section-inner">
    <div class="section-header">
      <span class="eyebrow eyebrow--accent">Behind the build</span>
      <h2 class="section-title">A two-sided marketplace, end to end.</h2>
      <p class="section-lede">
        Velko is a product by <a href="/">David Ferreira</a> — the SwiftUI app and its design
        system, the Supabase schema and edge functions that own pricing and booking state, and
        the Stripe payment, deposit and payout flows.
      </p>
    </div>

    <div class="build-grid">
      {build.map((b) => (
        <div class="build-panel">
          <h3 class="build-title">{b.label}</h3>
          <ul class="build-items">
            {b.items.map((i) => (
              <li>{i}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ─── CONTACT ───────────────────────────────────────────────────── -->
<section id="contact" class="section section--navy">
  <div class="section-inner get-inner">
    <span class="eyebrow eyebrow--accent">Get in touch</span>
    <h2 class="get-headline">Life’s better on the water.</h2>
    <p class="get-sub">
      Velko is launching in Portugal on iPhone and Android. If you run a school or shop, have
      gear to share, or want to talk about building something similar, I’d like to hear from you.
    </p>
    <div class="hero-actions">
      <a href={`mailto:${velkoOperator.email}?subject=Velko`} class="btn-primary">Email me about Velko</a>
      <a href="/#work" class="btn-ghost">See more work</a>
    </div>
  </div>
</section>

<!-- ─── FOOTER ────────────────────────────────────────────────────── -->
<footer class="footer">
  <p class="footer-links">
    <a href="/velko/support/">Support</a>
    <span aria-hidden="true">·</span>
    <a href="/velko/privacy/">Privacy</a>
    <span aria-hidden="true">·</span>
    <a href="/velko/terms/">Terms</a>
    <span aria-hidden="true">·</span>
    <a href="/velko/delete-account/">Delete account</a>
    <span aria-hidden="true">·</span>
    <a href="/velko/accessibility/">Accessibility</a>
    <span aria-hidden="true">·</span>
    <a href={complaintsBookUrl}>Livro de Reclamações</a>
    <span aria-hidden="true">·</span>
    <a href="/">Portfolio</a>
  </p>
  <p>{velkoOperator.name} · NIPC {velkoOperator.nipc} · {velkoOperator.address} · <span id="year"></span></p>
  <script>document.getElementById('year').textContent = new Date().getFullYear().toString();</script>
</footer>

</Layout>

<style>
/* Velko's own lime + ocean-aqua accents, on the site's dark navy shell */
:root {
  --accent:   #D6F76B;
  --accent-2: #39C6BD;
  --accent-soft: #D6F76B;
}

/* ── Nav ───────────────────────────────────────────────────────── */
.nav-shell {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 100;
  background: rgba(13,15,26,0.85);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border-bottom: 1px solid rgba(237,233,226,0.07);
}
.nav-inner {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 2rem;
  height: 60px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.nav-logo {
  font-family: 'Fraunces', Georgia, serif;
  font-size: 1.25rem;
  font-weight: 600;
  color: var(--ink);
  text-decoration: none;
  letter-spacing: -0.02em;
}
.nav-links {
  display: flex;
  align-items: center;
  gap: 2rem;
  list-style: none;
  margin: 0; padding: 0;
}
.nav-links a {
  font-size: 0.875rem;
  font-weight: 500;
  color: var(--muted);
  text-decoration: none;
  transition: color 0.15s;
}
.nav-links a:hover,
.nav-links a[data-active] { color: var(--ink); }
.nav-cta {
  background: var(--accent);
  color: #07171E !important;
  padding: 0.5rem 1.125rem;
  border-radius: 100px;
  transition: background 0.15s !important;
}
.nav-cta:hover { background: #e2fb8c !important; color: #07171E !important; }

/* ── Hero ──────────────────────────────────────────────────────── */
.hero-section {
  position: relative;
  padding-top: 120px;
  padding-bottom: 80px;
  overflow: hidden;
}
.hero-glow {
  position: absolute;
  inset: 0;
  background:
    radial-gradient(ellipse 50% 45% at 72% 42%, rgba(57,198,189,0.20) 0%, transparent 70%),
    radial-gradient(ellipse 35% 30% at 58% 78%, rgba(214,247,107,0.10) 0%, transparent 70%);
  pointer-events: none;
}
.hero-grid {
  position: relative;
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 2rem;
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: center;
  gap: 4rem;
  min-height: 80vh;
}
.hero-id {
  display: flex;
  align-items: center;
  gap: 1rem;
  margin-bottom: 2rem;
}
.hero-icon {
  width: 72px;
  height: 72px;
  border-radius: 18px;
  box-shadow: 0 12px 32px rgba(0,0,0,0.45);
  flex-shrink: 0;
}
.hero-name {
  font-family: 'Fraunces', Georgia, serif;
  font-size: 1.375rem;
  font-weight: 600;
  color: var(--ink);
  margin: 0;
  letter-spacing: -0.02em;
  line-height: 1.2;
}
.hero-kicker {
  font-size: 0.8125rem;
  color: var(--muted);
  margin: 0.15rem 0 0;
  line-height: 1.4;
}
.hero-headline {
  font-family: 'Fraunces', Georgia, serif;
  font-size: clamp(2.75rem, 6vw, 4.75rem);
  font-weight: 400;
  line-height: 1.05;
  letter-spacing: -0.03em;
