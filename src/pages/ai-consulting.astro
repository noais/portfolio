---
import Layout from '../layouts/Layout.astro';
import { profile, experience, personSchema } from '../data/profile';

const trustLogos = ['Volkswagen Group', 'FRiNGE', 'YEO Messaging', 'Prozis', 'Bosch', 'Portugal Telecom'];
const trustStats = [`${profile.yearsExperience} Years in Software`, 'Mobile Engineering Lead', 'iOS Architect', 'On-device ML & RAG in production code'];

const services = [
  {
    title: 'AI Readiness Assessment',
    pitch: 'Understand where AI creates real business value.',
    deliverables: ['AI opportunity map', 'ROI estimation', 'Architecture recommendations'],
  },
  {
    title: 'AI Architecture & Solution Design',
    pitch: 'Design scalable AI systems using LLMs, RAG, vector databases, MCP, function calling, AI agents, and hybrid cloud.',
    deliverables: ['LLM & RAG system design', 'Vector database selection', 'Agent & MCP architecture', 'Hybrid cloud deployment plan'],
  },
  {
    title: 'AI Prototype in 2 Weeks',
    pitch: 'Build a working MVP fast, with a clear path to production.',
    deliverables: ['Architecture', 'Backend', 'Mobile', 'Production roadmap'],
  },
  {
    title: 'Engineering Leadership',
    pitch: 'Help engineering teams improve delivery and adopt AI-native workflows.',
    deliverables: ['Delivery process improvements', 'Technical debt reduction', 'AI development workflow adoption', 'Engineering velocity increase'],
  },
];

const expertiseGroups = [
  { label: 'AI', items: ['OpenAI', 'Anthropic', 'Gemini', 'Local LLMs', 'Ollama', 'MCP', 'Function Calling', 'Agents', 'Prompt Engineering'] },
  { label: 'Data', items: ['RAG', 'Embeddings', 'Pinecone', 'Weaviate', 'Chroma', 'pgvector'] },
  { label: 'Mobile', items: ['Swift', 'SwiftUI', 'UIKit', 'visionOS', 'iOS Architecture'] },
  { label: 'Backend', items: ['Python', 'FastAPI', 'Docker', 'AWS', 'Supabase'] },
];

const process = [
  { step: '01', title: 'Discovery Call', description: 'Understand the business.' },
  { step: '02', title: 'AI Strategy', description: 'Define the right use case.' },
  { step: '03', title: 'Architecture', description: 'Design scalable AI systems.' },
  { step: '04', title: 'MVP', description: 'Build fast.' },
  { step: '05', title: 'Production', description: 'Scale confidently.' },
];

const whyCards = [
  { title: `${profile.yearsExperience} Years Engineering`, description: 'Native products shipped for automotive, live video, secure messaging, health and smart-home companies.' },
  { title: 'AI Native Thinking', description: 'AI is designed into the product — not added later.' },
  { title: 'Engineering Leadership', description: 'Led iOS architecture and delivery at Volkswagen Group, FRiNGE, YEO Messaging and Prozis.' },
  { title: 'Business First', description: 'Every AI solution must generate measurable value.' },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': `${profile.site}/ai-consulting/#service`,
      name: 'AI & Mobile Product Consulting',
      url: `${profile.site}/ai-consulting/`,
      provider: { '@id': personSchema['@id'] },
      areaServed: 'Worldwide',
      serviceType: services.map((s) => s.title),
      description: 'AI readiness assessments, LLM and RAG solution design, rapid AI prototypes and engineering leadership for mobile and digital products.',
    },
    personSchema,
  ],
};
---

<Layout
  title="David Ferreira — AI Solutions Consultant & AI-First Mobile Engineering Leader"
  description={`AI consultant and mobile engineering lead helping startups and enterprises build LLM-powered products — RAG, AI agents and production-grade mobile AI integrations, backed by ${profile.yearsExperience} years of software engineering.`}
  keywords="AI Consultant, AI Solutions Architect, AI Engineering Consultant, AI Product Consultant, AI Mobile Expert, AI Strategy Consultant, LLM Consultant, RAG Consultant, Generative AI Consultant, AI Engineering Leader, AI Mobile Development, Swift AI, iOS AI"
  structuredData={structuredData}
>

<a href="#main" class="skip-link">Skip to content</a>

<!-- ─── NAV ─────────────────────────────────────────────────────── -->
<header class="nav-shell">
  <nav class="nav-inner" aria-label="Primary">
    <a href="/" class="nav-logo" aria-label="David Ferreira, portfolio home">DF</a>
    <ul class="nav-links">
      <li class="nav-section"><a href="/">Portfolio</a></li>
      <li class="nav-section"><a href="#services" data-nav="services">Services</a></li>
      <li class="nav-section"><a href="#case-studies" data-nav="case-studies">Work</a></li>
      <li><a href={profile.cv}>CV</a></li>
      <li><a href="#contact" data-nav="contact" class="nav-cta">Book a call</a></li>
    </ul>
  </nav>
</header>

<main id="main">

<!-- ─── HERO ──────────────────────────────────────────────────────── -->
<section id="top" class="hero-section" aria-labelledby="hero-heading">
  <canvas id="hero-network" class="hero-network" aria-hidden="true"></canvas>

  <div class="hero-inner">
    <ul class="hero-chips" aria-label="At a glance">
      <li class="chip">{profile.yearsExperience} yrs</li>
      <li class="chip">AI · iOS</li>
      <li class="chip">Portugal</li>
    </ul>

    <h1 id="hero-heading" class="hero-headline">
      Helping companies build <em class="gradient-text">AI products</em><br />
      that users actually love.
    </h1>

    <p class="hero-sub">
      I help startups and enterprises integrate LLMs, AI Agents, and intelligent workflows
      into mobile and digital products — from strategy to production.
    </p>

    <div class="hero-actions">
      <a href="#contact" class="btn-primary">Book a Discovery Call</a>
      <a href="#case-studies" class="btn-ghost">See the work</a>
    </div>
  </div>
</section>

<!-- ─── TRUST STRIP ───────────────────────────────────────────────── -->
<div class="proof-strip">
  <p class="proof-label" id="trust-label">Companies worked with</p>
  <ul class="proof-domains proof-domains--logos" aria-labelledby="trust-label">
    {trustLogos.map((logo) => (
      <li>{logo}</li>
    ))}
  </ul>
</div>
<div class="stat-strip">
  <ul class="stat-list" aria-label="Background">
    {trustStats.map((stat) => (
      <li>{stat}</li>
    ))}
  </ul>
</div>

<!-- ─── SERVICES ──────────────────────────────────────────────────── -->
<section id="services" class="section">
  <div class="section-inner">
    <div class="section-header reveal">
      <span class="eyebrow">Services</span>
      <h2 class="section-title">AI consulting engagements built around outcomes.</h2>
    </div>

    <div class="services-grid reveal">
      {services.map((s) => (
        <div class="service-card glass">
          <h3 class="service-title">{s.title}</h3>
          <p class="service-pitch">{s.pitch}</p>
          <ul class="service-deliverables">
            {s.deliverables.map((d) => (
              <li>{d}</li>
