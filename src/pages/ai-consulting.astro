<!-- ─── CASE STUDIES ──────────────────────────────────────────────── -->
<section id="case-studies" class="section section--navy" aria-labelledby="case-studies-heading">
  <div class="section-inner">
    <div class="section-header section-header--light reveal">
      <span class="eyebrow eyebrow--lime">Selected work</span>
      <h2 id="case-studies-heading" class="section-title section-title--light">Applied AI and real-time systems, built into real products.</h2>
    </div>

    <div class="case-grid reveal">
      <!-- MyLedgerAI — AI-powered personal finance assistant -->
      <article class="case-card case-card--secondary">
        <div class="case-screen-single">
          <img src="/work/myledger-overview.webp" alt="MyLedgerAI overview screen with balance, budgets and spending chart" width="660" height="1434" loading="lazy" decoding="async" />
        </div>
        <div class="case-body">
          <span class="case-tag">iOS · LLM · RAG · Personal Finance</span>
          <h3 class="case-title">MyLedgerAI: grounded finance assistant</h3>
          <p class="case-problem">
            <strong>Challenge:</strong> Finance apps show what happened, but rarely turn that data into a clear next step, and generic chatbots answer without knowing the user's numbers.
          </p>
          <p class="case-outcome">
            <strong>Approach:</strong> A privacy-first, chat-led assistant that uses retrieval-augmented generation to ground every answer in the user's own transactions, budgets, goals and receipts. Data stays in on-device storage, and receipts are read with Vision OCR.
          </p>
          <div class="case-stack">
            <span>Swift</span><span>SwiftUI</span><span>SwiftData</span><span>RAG</span><span>Vision OCR</span>
          </div>
        </div>
      </article>

      <!-- YEO Messaging — on-device ML -->
