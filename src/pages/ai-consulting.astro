</section>

<!-- ─── EXPERTISE ─────────────────────────────────────────────────── -->
<section id="expertise" class="section section--navy">
  <div class="section-inner">
    <div class="section-header section-header--light reveal">
      <span class="eyebrow eyebrow--lime">Expertise</span>
      <h2 class="section-title section-title--light">AI, data, mobile, and backend — under one roof.</h2>
    </div>

    <div class="caps-grid reveal">
      {expertiseGroups.map((group) => (
        <div class="cap-panel">
          <h3 class="cap-title">{group.label}</h3>
          <ul class="cap-items">
            {group.items.map((item) => (
              <li>{item}</li>
